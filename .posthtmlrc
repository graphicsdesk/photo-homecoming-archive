          }
        ],
        "headline": "Homecoming’s past and present in photos",
        "dek": "Frames of the game, student spirit, and more—–look back at Homecoming weekend through Spectator’s archive.",
        "date": "October 20th, 2026",
        "byline": "By <a href=\"https://www.columbiaspectator.com/contributors/audrea-chen/\">Audrea Chen</a>",
        "byline2": "Web Design by <a href=\"https://www.columbiaspectator.com/contributors/audrea-chen/\">Audrea Chen</a>",
        "cover_asset": "https://cloudfront-us-east-1.images.arcpublishing.com/spectator/DYB2N42SDBHB7G2MBC3ZNHHDF4.jpg",
        "cover_caption": "Oct. 21, 2000: A frame from the 2000 Homecoming game. Pat Holder / Columbia Daily Spectator",
